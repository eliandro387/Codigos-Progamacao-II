#include <stdio.h>
#include <stdlib.h>
#include <locale.h>

typedef struct no Nos;
struct no {
	int valor;
	Nos *proximo;
	Nos *anterior;
};

Nos *inicio;
Nos *fim;
int tamanho;

// Criando prototipos de função
void criaLista();
Nos *aloca(int valor);
void insereInicio(int valor);
void insereFim(int valor);
void inserePosicao(int valor, int posicao);
void imprimeLista();
void buscar();
void removePosicao(int posicao);
void menu();

//Criar 2 elemmentos nulos na lista
void criaLista() {
	inicio = NULL;
	fim = NULL;
	tamanho = 0;
}
//Alocar um dado, e como funciona o esquema do lista duplamente encadeada:
Nos *aloca(int valor) {
	Nos *novo = (Nos*)malloc(sizeof(Nos));
	//um atalho mais limpo para: (*novo).valor
	novo->valor = valor;
	novo->anterior = NULL;
	novo->proximo = NULL;
	return novo;
}

void buscar() {
	int valor;
	printf("Digite o valor a ser buscado: ");
	scanf("%d", &valor);
	Nos *atual = inicio;
	int posicao = 0;
	while (atual != NULL) {
		if (atual->valor == valor) {
			printf("Valor %d encontrado na posição %d\n", valor, posicao);
			return;
		}
		atual = atual->proximo;
		posicao++;
	}
	printf("Valor %d não encontrado na lista.\n", valor);
}

//Inserir no inicio da lista:
void insereInicio(int valor) {
	Nos *novo = aloca(valor);   //criar novo no
	//verificar se o inicio for nulo, se sim, inicio recebe novo e o fim vai ser novo também, pois se os dois são nulos o inico e fim recebe o novo
	if(inicio==NULL){
		inicio=novo;
		fim=novo;

	//Se a lista já tiver dado se cria outro no e aponta o ant para o dado 2 e prox do dado 2 para o 1
	}else{
		Nos *atual; //criar novo no caso tenha dado no inicio da lista
		atual = inicio;
		novo->proximo = atual;
		atual->anterior = novo;
		inicio = novo;
	}
	tamanho++;
}

//Inserir no fim da lista:
void insereFim(int valor) {
	Nos *novo = aloca(valor);   //criar novo no
	//verificar se o inicio for nulo, se sim, inicio recebe novo e o fim vai ser novo também, pois se os dois são nulos o inico e fim recebe o novo
	if(inicio==NULL){
		inicio=novo;
		fim=novo;
	//Se a lista já tiver dado se cria outro no e aponta o ant para o dado 2 e prox do dado 2 para o 1
	}else{
		Nos *atual; //criar novo no caso tenha dado no inicio da lista
		atual = fim;
		novo->anterior = atual;
		atual->proximo = novo;
		fim = novo;
	}
	tamanho++;
}

void inserePosicao(int valor, int posicao) {
	posicao = posicao-1;
	Nos *novo = aloca(valor);
	Nos *atual;
	int i;

	// Decidindo o ponto de incio
	if (posicao < (tamanho/2)) {
		atual = inicio;
		i = 0;
	} else {
		atual = fim;
		i = tamanho - 1;
	}

	// Percorrer para encontrar a posição
	while ((i != posicao) && (i >= 0) && (i < tamanho)) {
		if (i < posicao) {
			i++;
			atual = atual->proximo;
		} else if (i > posicao) {
			i--;
			atual = atual->anterior;
		}
	}

	if (atual != NULL) {
		if (atual->anterior != NULL) {
			atual->anterior->proximo = novo;
			novo->anterior = atual->anterior;
		} else {
			inicio = novo; // Atual é o primeiro nó
		}

		if (atual != NULL) {
			atual->anterior = novo;
			novo->proximo = atual;
		} else {
			fim = novo; // Atual é o último nó
		}
		
		tamanho++;
	}
}
void removePosicao(int posicao) {
	posicao = posicao-1;
	Nos *atual;
	int i;

	// Decidindo o ponto de incio
	if (posicao < (tamanho/2)) {
		atual = inicio;
		i = 0;
	} else {
		atual = fim;
		i = tamanho - 1;
	}

	// Percorrer para encontrar a posição
	while ((i != posicao) && (i >= 0) && (i < tamanho)) {
		if (i < posicao) {
			i++;
			atual = atual->proximo;
		} else if (i > posicao) {
			i--;
			atual = atual->anterior;
		}
	}

	if (atual != NULL) {
		if (atual->anterior != NULL) {
			atual->anterior->proximo = atual->proximo;
		} else {
			inicio = atual->proximo; // Atual é o primeiro nó
		}

		if (atual->proximo != NULL) {
			atual->proximo->anterior = atual->anterior;
		} else {
			fim = atual->anterior; // Atual é o último nó
		}

		free(atual);
		tamanho--;
	}
}
//Função para imprimir a lista:
void imprimeLista() {
	Nos *atual;
	atual = inicio;
	while(atual){
		printf("%d",atual->valor);
		printf(" ponteiro anterior %p",(void*)atual->anterior);
		printf(" proximo ponteiro %p\n",(void*)atual->proximo);
		atual=atual->proximo;
	}
}
void menu() {
	int opcao, valor, posicao;
	do {
		printf("\nMenu:\n");
		printf("1. Inserir no início\n");
		printf("2. Inserir no fim\n");
		printf("3. Inserir em uma posição\n");
		printf("4. Remover de uma posição\n");
		printf("5. Imprimir lista\n");
		printf("6. Buscar elemento\n");
		printf("7. Sair\n");
		printf("Escolha uma opção: ");
		scanf("%d", &opcao);

		switch(opcao) {
			case 1:
				printf("Digite o valor a ser inserido: ");
				scanf("%d", &valor);
				insereInicio(valor);
				break;
			case 2:
				printf("Digite o valor a ser inserido: ");
				scanf("%d", &valor);
				insereFim(valor);
				break;
			case 3:
				printf("Digite o valor a ser inserido: ");
				scanf("%d", &valor);
				printf("Digite a posição: ");
				scanf("%d", &posicao);
				inserePosicao(valor, posicao);
				break;
			case 4:
				printf("Digite a posição do elemento a ser removido: ");
				scanf("%d", &posicao);
				removePosicao(posicao);
				break;
			case 5:
				imprimeLista();
				break;
			case 6:
				buscar();
				break;
			case 7:
				printf("Saindo...\n");
				break;
			default:
				printf("Opção inválida!\n");
		}
	} while(opcao != 7);
}

